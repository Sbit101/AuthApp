        }

    .sidebar.collapsed {
    width: 60px;
    overflow: hidden;
    }

    .sidebar.collapsed .nav-link-text {
    display: none;
    }

    .sidebar.collapsed .logo-text {
    display: none;
    }

    .sidebar.collapsed .nav-item {
    text-align: center;
    }

    .sidebar.collapsed .dropdown-toggle::after {
    display: none;
    }

    .sidebar.collapsed .dropdown-menu {
    position: absolute !important;
    left: 60px !important;
    top: 0 !important;
    }

    .main-content {
    margin-left: 140px;
    transition: all 0.3s;
    }

    .main-content.expanded {
    margin-left: 60px;
    }

    .nav-link {
    <!--color: rgba(255, 255, 255, 0.8);-->
    color: black;
    border-radius: 5px;
    margin: 2px 10px;
    padding: 10px 15px;
    }

    .nav-link:hover, .nav-link.active {
    <!--color: white;-->
    color: black;
    background-color: rgba(255, 255, 255, 0.1);
    }

            .nav-link:hover, .nav-link.active {
                background-color: rgb(3 2 2 / 10%);
            }

    .nav-link i {

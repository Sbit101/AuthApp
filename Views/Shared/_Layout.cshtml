    font-size: 1.2rem;
    }

    .dropdown-menu {
    background-color: #34495e;
    border: none;
    margin-left: 10px;
    }

    .dropdown-item {
    color: rgba(255, 255, 255, 0.8);
    }

    .dropdown-item:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    }


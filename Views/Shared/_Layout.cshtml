    margin-left: 10px;
    }

    .toggle-btn {
    background: none;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    }


    @@media(max-width: 768px) {
    .sidebar

    {
    width: 60px;
    overflow: hidden;
    }


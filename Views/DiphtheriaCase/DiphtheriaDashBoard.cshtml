        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-chart:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

    .stats-card {
        background: linear-gradient(135deg, #ff6b6b, #ee5a24);
        color: white;
        border-radius: 15px;

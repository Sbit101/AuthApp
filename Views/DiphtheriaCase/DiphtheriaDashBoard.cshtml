<script src="~/js/chart.js/Chart.js"></script>

<script>

            // Sales Chart (Line Chart)---------------------------------------------
            //graph 1 line
            const salesCtx = document.getElementById('salesChart').getContext('2d');
            const salesChart = new Chart(salesCtx, {
                type: 'line',
                data:{
                labels:[@foreach (var item in PatientHHS) { var f =@item.Month.ToString()+", ";@f;}],
                datasets: [{
                        label: 'Patient HouseHold Size',
                        data:[@foreach(var item in PatientHHS) { var f =@item.HouseHoldSizeCount.ToString()+ ", ";@f;}], 
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }
                    ,
                    {
                        label:'Diphtheria Cases by Month',
                        data:[@foreach(var item in PatientHHS) { var f = @item.CaseCount.ToString() + ", ";@f}],
                        backgroundColor: 'rgba(153, 102, 255, 0.2)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'top',
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero:true, //true
                            ticks: {
                                callback: function(value) {
                                    return '$' + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
            //----------------------------------------------------------------------



            // Product Chart (Horizontal Bar Chart)
                const productCtx = document.getElementById('productChart').getContext('2d');
                const productChart = new Chart(productCtx, {
                    type: 'bar',
                    data: {
                        labels:[@foreach(var item in PatientHHS) { var f = @item.Month.ToString() + ", ";@f;}],
                        datasets: [{
                            label: 'Diphtheria Cases per Month',
                            data:[@foreach(var item in PatientHHS) { var f = @item.CaseCount.ToString() + ", ";@f;}],
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.7)',
                                'rgba(54, 162, 235, 0.7)',
                                'rgba(255, 206, 86, 0.7)',
                                'rgba(75, 192, 192, 0.7)',
                                'rgba(153, 102, 255, 0.7)',
                                'rgba(41, 105, 105, 0.7)',

                                'rgba(255, 99, 132, 0.7)',
                                'rgba(54, 162, 235, 0.7)',
                                'rgba(255, 206, 86, 0.7)',
                                'rgba(75, 192, 192, 0.7)',
                                'rgba(153, 102, 255, 0.7)',
                                'rgba(41, 105, 105, 0.7)',
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(41, 105, 105, 1)',

                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(41, 105, 105, 1)',

                            ],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        plugins: {
                            legend: {
                                display: false
                                //position:'top' //true
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true
                                

                            }
                        }
                    }
                });
                //----------------------------------------------------------------------



    //graph 3 line day
    const salesCtxDay = document.getElementById('salesChartDay').getContext('2d');
    const salesChartDay = new Chart(salesCtxDay, {
        type: 'line',
        data:{
        labels:[@foreach (var item in PatientHHSDay) { var f =@item.Day.ToString()+", "; @f;}],
        datasets: [{
                label: 'Patient HouseHold Size',
                data:[@foreach(var item in PatientHHSDay) { var f =@item.HouseHoldSizeCount.ToString()+ ", ";@f;}],
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 2,
                tension: 0.4,
                fill: true
            }
            ,
            {
                label:'Diphtheria Cases by Day of Year',
                data:[@foreach(var item in PatientHHSDay) { var f = @item.CaseCount.ToString() + ", ";@f}],
                backgroundColor: 'rgba(153, 102, 255, 0.2)',
                borderColor: 'rgba(153, 102, 255, 1)',
                borderWidth: 2,
                tension: 0.4,
                fill: true
            }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                }
            },
            scales: {
                y: {
                    beginAtZero: true, //true
                    ticks: {
                        callback: function(value) {
                            return '$' + value.toLocaleString();
                        }
                    }
                }
            }
        }
    });
    //----------------------------------------------------------------------



            // Responsive adjustments
            window.addEventListener('resize', function() {
                salesChart.resize();
                productChart.resize();
                salesChartDay.resize();


            });


</script>

@{


    //Graph 1:Month line graph 
    var PatientHHS = Model.GroupBy(p => p.DateofFirstClinicalDiagnosis.Month)
                                .Select(group => new
                                {
                                    Month = group.Key,
                                    HouseHoldSizeCount = group.Sum(k => k.PatientHouseHoldSize),
                                    CaseCount = group.Count(),
                                    Monster = MpoxCaseController.Fmonth(group.Key)

                                }).OrderBy(x => x.Month);


    var mx = new List<string>();                       
    foreach (var item in PatientHHS)
    {
        mx.Add(item.Monster.ToString().Trim());

    }
    //============================================================================================


}


@{

    //--------------------------------------------------------------------------------------------
    //graph 3 daily
    //Graph 1: line graph
    var PatientHHSDay = Model.GroupBy(p => p.DateofFirstClinicalDiagnosis.DayOfYear)
                                .Select(group => new
                                {
                                    Day = group.Key,
                                    HouseHoldSizeCount = group.Sum(k => k.PatientHouseHoldSize),
                                    CaseCount = group.Count(),

                                }).OrderBy(x => x.Day);


    var mxday = new List<string>();
    foreach (var item in PatientHHSDay)
    {
        mxday.Add(item.Day.ToString().Trim());

    }


}






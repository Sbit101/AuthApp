<h1>Details</h1>

@if (Model.PatientDiphtheriaPicture == null)
{
    <img src="~/defaultpic.png" class="img-fluid rounded mx-auto d-block" height="250px" width="0" alt="...">

}
@if (Model.PatientDiphtheriaPicture != null)
{
